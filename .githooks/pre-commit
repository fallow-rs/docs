#!/usr/bin/env bash
set -e

# Keep public-content-manifest.json in step with the content it describes.
#
# The manifest is fully derived: per-file sha256 and byte counts plus an
# aggregate hash. CI runs `npm run content:check` against the checked-out
# commit, so a commit that edits public content without refreshing the
# manifest turns main red with "public-content-manifest.json is stale". That
# is a mechanical failure, so a hook can prevent it outright.
#
# Regeneration takes well under a second, so this runs unconditionally rather
# than behind a list of content paths. A hardcoded list here would be a second
# copy of the one in scripts/public-content.mjs, free to drift the moment a
# content directory is added.
#
# The generator reads the WORKING TREE, not the index. A manifest is only
# valid for this commit when every file it describes is in the index at the
# same content. When that does not hold, refusing beats committing a manifest
# that describes something other than the commit.

if ! command -v node > /dev/null 2>&1; then
  echo "pre-commit: node is missing; skipping the content manifest refresh (CI still enforces it)." >&2
  exit 0
fi

npm run --silent content:manifest > /dev/null

if git diff --quiet -- public-content-manifest.json; then
  exit 0
fi

# Every path the refreshed manifest names must be staged at this exact content.
mismatched=$(
  node -e '
    const { execFileSync } = require("child_process");
    const fs = require("fs");
    const manifest = JSON.parse(fs.readFileSync("public-content-manifest.json", "utf8"));
    const bad = [];
    for (const entry of manifest.content.files) {
      if (entry.path === "public-content-manifest.json") continue;
      try {
        const staged = execFileSync("git", ["rev-parse", ":" + entry.path], { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
        const onDisk = execFileSync("git", ["hash-object", entry.path], { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
        if (staged !== onDisk) bad.push(entry.path + " (staged content differs from the working tree)");
      } catch {
        bad.push(entry.path + " (not staged)");
      }
    }
    if (bad.length) console.log(bad.join("\n"));
  '
)

if [ -n "$mismatched" ]; then
  git checkout -- public-content-manifest.json
  echo "pre-commit: the content manifest cannot be made to match this commit." >&2
  echo "It is generated from the working tree, but these files differ from what is staged:" >&2
  printf '  %s\n' "$mismatched" >&2
  echo "Stage them, or stash them, then commit again." >&2
  exit 1
fi

git add public-content-manifest.json
echo "pre-commit: public-content-manifest.json refreshed and staged."
