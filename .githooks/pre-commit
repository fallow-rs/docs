#!/usr/bin/env bash
set -e

# Refresh public-content-manifest.json so that `npm run content:check` passes in CI.
# The hook always runs: a list of content paths here would copy the allowlist
# in scripts/public-content.mjs and could drift from it.
# The generator reads the working tree, not the index, so the hook refuses the
# commit when a listed file is not staged at its working-tree content.

if ! command -v node > /dev/null 2>&1; then
  echo "pre-commit: node is not installed. The hook did not refresh public-content-manifest.json. CI still checks it." >&2
  exit 0
fi

npm run --silent content:manifest > /dev/null

if git diff --quiet -- public-content-manifest.json; then
  exit 0
fi

mismatched=$(
  node -e '
    const { execFileSync } = require("child_process");
    const fs = require("fs");
    const manifest = JSON.parse(fs.readFileSync("public-content-manifest.json", "utf8"));
    const bad = [];
    for (const entry of manifest.content.files) {
      try {
        const staged = execFileSync("git", ["rev-parse", ":" + entry.path], { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
        const onDisk = execFileSync("git", ["hash-object", entry.path], { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
        if (staged !== onDisk) bad.push(entry.path + " (staged content differs from the working tree)");
      } catch {
        bad.push(entry.path + " (not staged)");
      }
    }
    if (bad.length) console.log(bad.join("\n"));
  '
)

if [ -n "$mismatched" ]; then
  git checkout -- public-content-manifest.json
  echo "pre-commit: public-content-manifest.json cannot match this commit." >&2
  echo "The manifest comes from the working tree, but these files are not staged at their working-tree content:" >&2
  printf '  %s\n' "$mismatched" >&2
  echo "Stage or stash these files, then commit again." >&2
  exit 1
fi

git add public-content-manifest.json
echo "pre-commit: public-content-manifest.json refreshed and staged."
