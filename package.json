{
  "name": "fallow-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run content:check && npm test && npm run docs:anchors",
    "content:archive": "node scripts/public-content.mjs --archive dist",
    "content:check": "node scripts/public-content.mjs --check",
    "content:manifest": "node scripts/public-content.mjs --write",
    "docs:anchors": "node scripts/check-anchors.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
